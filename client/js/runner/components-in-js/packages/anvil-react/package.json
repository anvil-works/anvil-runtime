{
    "name": "@anvil-works/anvil-react",
    "version": "1.1.6",
    "description": "A library for building Anvil Components in React",
    "main": "./index.js",
    "exports": {
        ".": "./index.js",
        "./designer": "./designer.js",
        "./util": "./util.js"
    },
    "type": "module",
    "scripts": {
        "clean": "find ./ -maxdepth 1 -type f \\( -name '*.js' -o -name '*.d.ts' \\) -delete",
        "build": "pnpm --ignore-workspace run clean && tsup src/index.ts src/designer.ts src/util.tsx --format esm --dts --out-dir ./"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/daviesian/anvil.git"
    },
    "author": "The Anvil Team",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/anvil-works/anvil-react/issues"
    },
    "homepage": "https://github.com/anvil-works/anvil-react#readme",
    "peerDependencies": {
        "react": "^18.0.0 || ^19.3.0",
        "react-dom": "^18.0.0 || ^19.3.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.3",
        "@types/jquery": "^3.5.32"
    },
    "files": [
        "*.js",
        "*.d.ts"
    ],
    "packageManager": "pnpm@11.9.0"
}
