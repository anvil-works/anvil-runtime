{
    "extends": "../../../../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "types": [
            "react",
            "react-dom",
            "../../../../../js/globals",
            "jquery"
        ],
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@runtime/*": [
                "../../../../../js/*"
            ],
            "@Sk": [
                "../../../../../js/@Sk"
            ],
            "PyDefUtils": [
                "../../../../../js/PyDefUtils"
            ]
        },
        "moduleResolution": "Bundler"
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.tsx"
    ],
    "exclude": [
        "@types/jsx.ts"
    ]
}
